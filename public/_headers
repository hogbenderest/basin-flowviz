/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'

/index.html
  Cache-Control: no-store, must-revalidate

/style.css
  Cache-Control: public, max-age=31536000, immutable

/app.js
  Cache-Control: public, max-age=31536000, immutable

/charts.js
  Cache-Control: public, max-age=31536000, immutable

/ask.js
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable
