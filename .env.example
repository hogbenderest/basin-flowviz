# Copy to .dev.vars (local) or export before deploying. Never commit real values.
# R2 API token with Admin Read & Write: used as the Iceberg sink catalog token
# and as the Worker's Basin SQL console token. Account-wide by open-beta design;
# compensating controls: dedicated token, Worker secret only, never logged.
BASIN_SQL_TOKEN=

# Strong random secret (32 bytes) for Vector -> /relay POST auth.
#   openssl rand -hex 32
RELAY_SECRET=

# Optional: stream auth token with Basin Pipelines Send permission, if the
# ha/homelab streams are created with HTTP authentication enabled.
BASIN_INGEST_TOKEN=

# Cloudflare Access service token pair for the Vector relay (machines cannot
# complete OTP). Mint in Zero Trust > Service Auth, then attach a policy with
# Action "Service Auth" (NOT Allow) to the Access application protecting the
# Worker's domain - an Allow action with a service-token-only selector still
# demands an identity-provider login.
RELAY_CF_ID=
RELAY_CF_SECRET=
