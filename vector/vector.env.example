# Copy to ~/basin-flowviz-vector/vector.env on the Vector host and fill in
# real values. Never commit real values. This file is the INPUT to
# scripts/make-secrets-json.sh, which converts it into secrets.json - the
# file that vector-central.toml actually reads via the [secret.basin] file
# backend (Vector 0.57+ removed ${VAR} env interpolation from configs).

# Home Assistant MQTT user (the vector-bridge user; see docs/HA-SETUP.md).
MQTT_USER=
MQTT_PASSWORD=

# UniFi Integration API on the UniFi OS Server console (port 11443).
# Mint the key in the console: Settings > Control Plane > Integrations >
# API Keys. Get the siteId from:
#   curl -sk -H "X-API-KEY: <key>" \
#     https://<console>:11443/proxy/network/integration/v1/sites
UNIFI_DEVICES_URL=https://192.168.86.111:11443/proxy/network/integration/v1/sites/<siteId>/devices?limit=200
UNIFI_CLIENTS_URL=https://192.168.86.111:11443/proxy/network/integration/v1/sites/<siteId>/clients?limit=200
UNIFI_API_KEY=

# Cloudflare ingest auth (Basin Pipelines Send token) and the relay pair:
# the Worker /relay bearer secret plus the Access service token headers.
BASIN_INGEST_TOKEN=
RELAY_SECRET=
RELAY_CF_ID=
RELAY_CF_SECRET=

# Per-deployment salt mixed into the dns_queries client hash before it is
# stored (openssl rand -hex 16). Without it the hash of a LAN client IP is
# reversible by a 254-candidate dictionary attack.
CLIENT_SALT=
